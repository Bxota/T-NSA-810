<?xml version="1.0"?>
<pfsense>
	<version>22.7</version>
	<lastchange></lastchange>
	<system>
		<optimization>normal</optimization>
		<hostname>pf-s2</hostname>
		<domain>s2.cia</domain>
		<dnsserver>8.8.8.8</dnsserver>
		<dnsallowoverride></dnsallowoverride>
		<timezone>Europe/Paris</timezone>
		<timeservers>pool.ntp.org</timeservers>
		<webgui>
			<protocol>https</protocol>
			<port></port>
		</webgui>
		<ssh>
			<enable>enabled</enable>
		</ssh>
		<user>
			<name>admin</name>
			<descr><![CDATA[System Administrator]]></descr>
			<scope>system</scope>
			<groupname>admins</groupname>
			<bcrypt-hash>$2b$10$zzCn7FyXg/e/1OeKKO6gIOQ/1y74DDEYPFrxR3uSdBTX2/KrJLb56</bcrypt-hash>
			<uid>0</uid>
			<priv>user-shell-access</priv>
		</user>
		<group>
			<name>admins</name>
			<description><![CDATA[System Administrators]]></description>
			<scope>system</scope>
			<gid>1999</gid>
			<member>0</member>
			<priv>page-all</priv>
		</group>
	</system>
	<interfaces>
		<wan>
			<enable></enable>
			<if>vtnet0</if>
			<descr><![CDATA[WAN]]></descr>
			<ipaddr>dhcp</ipaddr>
		</wan>
		<lan>
			<enable></enable>
			<if>vtnet1</if>
			<descr><![CDATA[LAN]]></descr>
			<ipaddr>10.2.0.1</ipaddr>
			<subnet>24</subnet>
		</lan>
	</interfaces>
	<dhcpd></dhcpd>
	<nat>
		<outbound>
			<mode>automatic</mode>
		</outbound>
		<rule>
			<source><any></any></source>
			<destination>
				<network>wanip</network>
				<port>2222</port>
			</destination>
			<protocol>tcp</protocol>
			<target>10.2.0.5</target>
			<local-port>22</local-port>
			<interface>wan</interface>
			<descr><![CDATA[Bastion SSH (externe 2222 -> bastion 22)]]></descr>
			<associated-rule-id>nat_bastion_ssh</associated-rule-id>
		</rule>
	</nat>
	<filter>
		<rule>
			<type>pass</type>
			<interface>lan</interface>
			<ipprotocol>inet</ipprotocol>
			<source><network>lan</network></source>
			<destination><any></any></destination>
			<descr><![CDATA[Default allow LAN to any]]></descr>
		</rule>
		<rule>
			<type>pass</type>
			<interface>openvpn</interface>
			<ipprotocol>inet</ipprotocol>
			<source><any></any></source>
			<destination><any></any></destination>
			<descr><![CDATA[Allow inter-site VPN traffic]]></descr>
		</rule>
		<rule>
			<associated-rule-id>nat_bastion_ssh</associated-rule-id>
			<type>pass</type>
			<interface>wan</interface>
			<ipprotocol>inet</ipprotocol>
			<protocol>tcp</protocol>
			<source><any></any></source>
			<destination>
				<address>10.2.0.5</address>
				<port>22</port>
			</destination>
			<descr><![CDATA[NAT Bastion SSH]]></descr>
		</rule>
		<rule>
			<type>block</type>
			<interface>wan</interface>
			<direction>out</direction>
			<floating>yes</floating>
			<disabled></disabled>
			<ipprotocol>inet</ipprotocol>
			<source><any></any></source>
			<destination><any></any></destination>
			<descr><![CDATA[KILLSWITCH - enable to cut WAN (reversible)]]></descr>
		</rule>
	</filter>
	<openvpn>
		<openvpn-client>
			<vpnid>1</vpnid>
			<mode>p2p_shared_key</mode>
			<protocol>UDP4</protocol>
			<dev_mode>tun</dev_mode>
			<interface>wan</interface>
			<server_addr>__IP_WAN_PF_S1__</server_addr>
			<server_port>1194</server_port>
			<description><![CDATA[S2<->S1 site-to-site]]></description>
			<tunnel_network>10.8.0.0/24</tunnel_network>
			<remote_network>10.1.0.0/24</remote_network>
			<data_ciphers_fallback>AES-256-GCM</data_ciphers_fallback>
			<digest>SHA256</digest>
			<shared_key></shared_key>
		</openvpn-client>
	</openvpn>
	<unbound>
		<enable></enable>
		<active_interface>lan,openvpn</active_interface>
		<dnssec></dnssec>
		<hosts>
			<host>bastion</host>
			<domain>s2.cia</domain>
			<ip>10.2.0.5</ip>
			<descr><![CDATA[Bastion]]></descr>
		</hosts>
		<hosts>
			<host>web</host>
			<domain>s2.cia</domain>
			<ip>10.2.0.30</ip>
			<descr><![CDATA[Web interne]]></descr>
		</hosts>
		<domainoverrides>
			<domain>s1.cia</domain>
			<ip>10.8.0.1</ip>
			<descr><![CDATA[Forward zone S1 via VPN]]></descr>
		</domainoverrides>
	</unbound>
</pfsense>
