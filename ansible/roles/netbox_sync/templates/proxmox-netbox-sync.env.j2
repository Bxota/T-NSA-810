# Variables d'environnement du sync Proxmox -> NetBox (généré par Ansible).
# Secrets injectés depuis Doppler via l'environnement de deploy.sh.
#
# Cette infra utilise UN SEUL jeu de creds cluster : les deux nœuds (pve6/pve7)
# sont dans le même cluster, joignables via le même endpoint API. On interroge
# donc le même endpoint pour chaque nœud, en ne changeant que le nom du nœud.
# La liste proxmox_sync_nodes est définie dans group_vars/all.yml.
NETBOX_URL=http://localhost
NETBOX_TOKEN={{ lookup('env', 'NETBOX_API_TOKEN') }}
VERIFY_SSL=false
PROXMOX_NODES={{ proxmox_sync_nodes | to_json }}
# pfSense n'a pas de cloud-init (IP LAN statique) → on la fournit ici au sync.
STATIC_IPS={{ {'cia-pf-s1': pfsense_s1_lan_cidr, 'cia-pf-s2': pfsense_s2_lan_cidr} | to_json }}
