# Variables d'environnement du sync Proxmox → NetBox (généré par Ansible).
# Secrets injectés depuis Doppler via l'environnement de deploy.sh.
NETBOX_URL=http://localhost
NETBOX_TOKEN={{ lookup('env', 'NETBOX_API_TOKEN') }}
VERIFY_SSL=false
PROXMOX_NODES={{ [
  {'url': lookup('env','PROXMOX_S1_API_URL'), 'node': lookup('env','PROXMOX_S1_NODE'),
   'token_id': lookup('env','PROXMOX_S1_TOKEN_ID'), 'token_secret': lookup('env','PROXMOX_S1_TOKEN_SECRET')},
  {'url': lookup('env','PROXMOX_S2_API_URL'), 'node': lookup('env','PROXMOX_S2_NODE'),
   'token_id': lookup('env','PROXMOX_S2_TOKEN_ID'), 'token_secret': lookup('env','PROXMOX_S2_TOKEN_SECRET')}
] | to_json }}
STATIC_IPS={{ {'cia-pfsense-s1': pfsense_s1_lan_cidr, 'cia-pfsense-s2': pfsense_s2_lan_cidr} | to_json }}
